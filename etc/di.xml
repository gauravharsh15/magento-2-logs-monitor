<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="logmonitor_process_command" xsi:type="object">Gaurav\LogMonitor\Console\Command\ProcessLogsCommand</item>
            </argument>
        </arguments>
    </type>

    <!-- Console commands are instantiated on every bin/magento call (including
         setup:install / setup:upgrade), so defer building the reader until the
         command actually runs. -->
    <type name="Gaurav\LogMonitor\Console\Command\ProcessLogsCommand">
        <arguments>
            <argument name="logReader" xsi:type="object">Gaurav\LogMonitor\Model\LogReader\Proxy</argument>
        </arguments>
    </type>

    <virtualType name="Gaurav\LogMonitor\Model\ResourceModel\Alert\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">gaurav_logmonitor_alerts</argument>
            <argument name="resourceModel" xsi:type="string">Gaurav\LogMonitor\Model\ResourceModel\Alert</argument>
        </arguments>
    </virtualType>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="logmonitor_alerts_grid_data_source" xsi:type="string">Gaurav\LogMonitor\Model\ResourceModel\Alert\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

</config>
