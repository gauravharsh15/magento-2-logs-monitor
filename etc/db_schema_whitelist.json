{
    "gaurav_logmonitor_state": {
        "column": {
            "entity_id": true,
            "file_name": true,
            "last_byte_offset": true,
            "fingerprint": true
        },
        "constraint": {
            "PRIMARY": true,
            "UNQ_GAURAV_LOGMONITOR_STATE_FILE_NAME": true
        }
    },
    "gaurav_logmonitor_alerts": {
        "column": {
            "entity_id": true,
            "log_file": true,
            "error_hash": true,
            "error_preview": true,
            "severity": true,
            "full_trace": true,
            "occurrence_count": true,
            "last_notified_count": true,
            "is_notified": true,
            "last_notified_at": true,
            "first_seen_at": true,
            "last_seen_at": true
        },
        "index": {
            "GAURAV_LOGMONITOR_ALERTS_LAST_SEEN_AT": true
        },
        "constraint": {
            "PRIMARY": true,
            "GAURAV_LOGMONITOR_UNIQUE_HASH": true
        }
    },
    "gaurav_logmonitor_archive_state": {
        "column": {
            "entity_id": true,
            "archive_name": true,
            "file_size": true,
            "processed_at": true
        },
        "constraint": {
            "PRIMARY": true,
            "UNQ_GAURAV_LOGMONITOR_ARCHIVE_NAME_SIZE": true
        }
    }
}
