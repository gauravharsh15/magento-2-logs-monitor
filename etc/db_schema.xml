<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    
    <table name="gaurav_logmonitor_state" resource="default" engine="innodb" comment="Log Monitor File State Tracking">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="file_name" nullable="false" length="255" comment="Log File Name"/>
        <column xsi:type="int" name="last_byte_offset" padding="10" unsigned="true" nullable="false" default="0" comment="Last Read Byte Offset"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="UNQ_GAURAV_LOGMONITOR_STATE_FILE_NAME">
            <column name="file_name"/>
        </constraint>
    </table>

    <table name="gaurav_logmonitor_alerts" resource="default" engine="innodb" comment="Tracks unique errors for alerts">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="log_file" length="100" nullable="false" comment="Short Log file name e.g. exception.log"/>
        <column xsi:type="varchar" name="error_hash" length="32" nullable="false" comment="MD5 fingerprint of the error string"/>
        <column xsi:type="text" name="error_preview" nullable="false" comment="Snippet of the error for the email"/>
        <column xsi:type="varchar" name="severity" nullable="true" length="32" comment="Log Severity Level"/>
        <column xsi:type="text" name="full_trace" nullable="true" comment="Full Exception Stack Trace"/>
        <column xsi:type="int" name="occurrence_count" padding="10" unsigned="true" nullable="false" default="1" comment="Number of times this error occurred"/>
        <column xsi:type="int" name="last_notified_count" padding="10" unsigned="true" nullable="false" default="0" comment="occurrence_count value at the time of the last notification email"/>
        <column xsi:type="smallint" name="is_notified" padding="5" unsigned="true" nullable="false" default="0" comment="0 = never emailed, 1 = has been emailed at least once"/>
        <column xsi:type="timestamp" name="first_seen_at" nullable="false" default="CURRENT_TIMESTAMP" comment="When this specific error first happened"/>
        <column xsi:type="timestamp" name="last_seen_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="When this error happened last"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="GAURAV_LOGMONITOR_UNIQUE_HASH">
            <column name="log_file"/>
            <column name="error_hash"/>
        </constraint>
    </table>

    <table name="gaurav_logmonitor_archive_state" resource="default" engine="innodb" comment="Tracks already-processed rotated/gzipped log archives">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="archive_name" nullable="false" length="255" comment="Rotated/Archived File Name, e.g. exception.log.1.gz"/>
        <column xsi:type="bigint" name="file_size" padding="20" unsigned="true" nullable="false" comment="Archive File Size in Bytes (archives are immutable once rotated)"/>
        <column xsi:type="timestamp" name="processed_at" nullable="false" default="CURRENT_TIMESTAMP" comment="When this archive was fully scanned"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="UNQ_GAURAV_LOGMONITOR_ARCHIVE_NAME_SIZE">
            <column name="archive_name"/>
            <column name="file_size"/>
        </constraint>
    </table>
</schema>